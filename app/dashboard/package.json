{
  "name": "zagros-dashboard",
  "private": true,
  "version": "1.0.0-alpha.7",
  "description": "Zagros unified management panel — a single, modern dashboard for the Zagros multi-core VPN platform.",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc && vite build --outDir build --assetsDir statics && node scripts/postbuild.mjs",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.51.1",
    "@tanstack/react-virtual": "^3.8.4",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.12",
    "framer-motion": "^11.3.8",
    "lucide-react": "^0.417.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.25.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
