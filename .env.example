# ══════════════════════════════════════════════════════════════════════════
#  Zagros — .env template
#
#  This file is the SINGLE source of configuration truth (same model as
#  Marzban): copy it to `.env`, edit it, then apply everything with:
#
#      zagros restart
#
#  Docker deployments only MOUNT this file into the container — nothing is
#  hardcoded in the image — so every change here takes effect on restart.
#  CLI helpers: `zagros config show | get KEY | set KEY VALUE | edit | reload`
#
#  Precedence: real process environment (tests/CI only) > this file >
#  built-in defaults. Lines starting with # are inactive defaults/examples.
# ══════════════════════════════════════════════════════════════════════════

# ─────────────────────────── Identity / Domain ────────────────────────────
# Public hostname of this panel. Set it once and PANEL_BASE_URL /
# APP_BASE_URL / absolute subscription links are derived automatically.
# DOMAIN = "panel.example.com"

# Full base URLs (override the DOMAIN-derived defaults if needed).
# PANEL_BASE_URL = "https://panel.example.com"
# APP_BASE_URL   = "https://panel.example.com"

# ─────────────────────────── HTTP bind & TLS ──────────────────────────────
# Listening address — honored VERBATIM (no runtime ever rewrites it).
UVICORN_HOST = "0.0.0.0"
UVICORN_PORT = 8000
# Unix domain socket instead of host:port (takes precedence when set).
# UVICORN_UDS = "/run/zagros.socket"

# TLS_MODE: auto | on | off
#   auto (default)  TLS is enabled when both SSL files below are set,
#                   otherwise plain HTTP on UVICORN_HOST.
#   on              TLS REQUIRED — refuses to start without cert+key.
#   off             force plain HTTP even if cert/key are set
#                   (use when a reverse proxy terminates TLS upstream).
# TLS_MODE = "auto"
# UVICORN_SSL_CERTFILE    = "/var/lib/zagros/certs/example.com/fullchain.pem"
# UVICORN_SSL_KEYFILE     = "/var/lib/zagros/certs/example.com/key.pem"
# Optional CA file (client-certificate verification chains):
# UVICORN_SSL_CA_CERTFILE = "/var/lib/zagros/certs/ca.pem"
# public = cert must be signed by a trusted CA · private = allow self-signed (testing only)
# UVICORN_SSL_CA_TYPE = "public"

# ─────────────────────────── Database ─────────────────────────────────────
# Zagros platform schema (users, cores, devices, quota, sessions, ...).
# ZAGROS_DATABASE_URL = "sqlite:////var/lib/zagros/zagros.db"
# ZAGROS_DATABASE_URL = "mysql+pymysql://zagros:secret@127.0.0.1:3306/zagros"
# ZAGROS_DATABASE_URL = "postgresql+psycopg://zagros:secret@127.0.0.1:5432/zagros"

# Legacy stack schema (admin users, legacy tables). The installer points
# both URLs at the chosen engine; SQLite uses a separate file.
# SQLALCHEMY_DATABASE_URL = "sqlite:////var/lib/zagros/db.sqlite3"
# SQLALCHEMY_POOL_SIZE = 10
# SQLIALCHEMY_MAX_OVERFLOW = 30

# ─────────────────────────── Security ─────────────────────────────────────
# Master secret protecting stored app credentials & sealed delivery keys.
# REQUIRED in production (min 16 chars): `openssl rand -hex 32`
# ZAGROS_SECRET_KEY = "change-me-32-bytes-minimum!!!!!!!!!"

# CORS allow-list (comma separated). Empty = same-origin only. Never use "*".
# ALLOWED_ORIGINS = "https://panel.example.com"

# HTTP Host-header allow-list (comma separated). Empty = no restriction.
# Requests with an unlisted Host header are rejected with 400.
# TRUSTED_HOSTS = "panel.example.com"

## We highly recommend adding admins with `zagros admin create` instead of
## the following variables, which are effectively hardcoded credentials.
# SUDO_USERNAME = "admin"
# SUDO_PASSWORD = "admin"

# ─────────────────────────── Dashboard ────────────────────────────────────
# DASHBOARD_PATH = "/dashboard/"

# ─────────────────────────── Subscription ─────────────────────────────────
# Absolute prefix for subscription links. Default: derived from DOMAIN /
# PANEL_BASE_URL. A literal '*' inside the value is replaced with a random
# per-user salt (useful against URL scanning).
# SUBSCRIPTION_URL_PREFIX = "https://panel.example.com"
# Path segment of subscription links (default: sub — /sub/<token>).
# SUBSCRIPTION_PATH = "sub"
# Custom subscription page template (see app/templates/).
# SUBSCRIPTION_TEMPLATE = "subscription/index.html"

## Headers sent with subscription responses.
# SUB_PROFILE_TITLE = "Subscription"
# SUB_SUPPORT_URL = "https://t.me/support"
# SUB_UPDATE_INTERVAL = "12"

# ─────────────────────────── Client app / branding ────────────────────────
# ZAGROS_PORTAL_TITLE = "اشتراک من"
# ZAGROS_APP_NAME = "Zagros"
# Client Authentication Mode: subscription_link | application_login
# ZAGROS_CLIENT_AUTH_MODE = "subscription_link"

# ─────────────────────────── Drivers (Xray core) ──────────────────────────
# XRAY_JSON = "/var/lib/zagros/cores/xray/xray_config.json"
# XRAY_EXECUTABLE_PATH = "/var/lib/zagros/cores/xray/bin/xray"
# XRAY_ASSETS_PATH = "/var/lib/zagros/cores/xray/assets"
# XRAY_EXCLUDE_INBOUND_TAGS = "INBOUND_X INBOUND_Y"
# XRAY_FALLBACKS_INBOUND_TAG = "INBOUND_X"
# Other cores (sing-box, hysteria, ...) are managed from the panel /
# `zagros cores ...`; their settings live in the database, not here.

## Enable JSON config for compatible clients (mux, fragment, ...). Default False.
# USE_CUSTOM_JSON_DEFAULT = True
## Per-client overrides (only when USE_CUSTOM_JSON_DEFAULT=True):
# USE_CUSTOM_JSON_FOR_V2RAYN = False
# USE_CUSTOM_JSON_FOR_V2RAYNG = True
# USE_CUSTOM_JSON_FOR_STREISAND = False
# USE_CUSTOM_JSON_FOR_HAPP = False

# CUSTOM_TEMPLATES_DIRECTORY = "/var/lib/zagros/templates/"
# CLASH_SUBSCRIPTION_TEMPLATE  = "clash/default.yml"
# CLASH_SETTINGS_TEMPLATE      = "clash/settings.yml"
# SINGBOX_SUBSCRIPTION_TEMPLATE = "singbox/default.json"
# SINGBOX_SETTINGS_TEMPLATE     = "singbox/settings.json"
# MUX_TEMPLATE = "mux/default.json"
# V2RAY_SUBSCRIPTION_TEMPLATE = "v2ray/default.json"
# V2RAY_SETTINGS_TEMPLATE     = "v2ray/settings.json"
# HOME_PAGE_TEMPLATE = "home/index.html"

## External config imported into v2ray-format subscriptions.
# EXTERNAL_CONFIG = "config://..."

# ─────────────────────────── Nodes ────────────────────────────────────────
## Skip recording node usage statistics (default false).
# DISABLE_RECORDING_NODE_USAGE = false
# Node endpoints themselves are managed in the database (panel / CLI),
# not via .env.

# ─────────────────────────── Telegram ─────────────────────────────────────
# TELEGRAM_API_TOKEN = 123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# TELEGRAM_ADMIN_ID = 987654321, 123456789
# TELEGRAM_LOGGER_CHANNEL_ID = -1234567890123
# TELEGRAM_DEFAULT_VLESS_FLOW = "xtls-rprx-vision"
# TELEGRAM_PROXY_URL = "http://localhost:8080"

# ─────────────────────────── Webhooks & notifications ─────────────────────
# DISCORD_WEBHOOK_URL = "https://discord.com/api/webhooks/xxxxxxx"
# WEBHOOK_ADDRESS = "http://127.0.0.1:9000/,http://127.0.0.1:9001/"
# WEBHOOK_SECRET = "something-very-very-secret"
# RECURRENT_NOTIFICATIONS_TIMEOUT = 180
# NUMBER_OF_RECURRENT_NOTIFICATIONS = 3
# NOTIFY_DAYS_LEFT = 3,7
# NOTIFY_REACHED_USAGE_PERCENT = 80,90
# NOTIFY_STATUS_CHANGE = True
# NOTIFY_USER_CREATED = True
# NOTIFY_USER_UPDATED = True
# NOTIFY_USER_DELETED = True
# NOTIFY_USER_DATA_USED_RESET = True
# NOTIFY_USER_SUB_REVOKED = True
# NOTIFY_IF_DATA_USAGE_PERCENT_REACHED = True
# NOTIFY_IF_DAYS_LEFT_REACHED = True
# NOTIFY_LOGIN = True
## IPs/hosts exempt from login notifications.
# LOGIN_NOTIFY_WHITE_LIST = "1.1.1.1,127.0.0.1"

# ─────────────────────────── Jobs (seconds) ───────────────────────────────
# JOB_CORE_HEALTH_CHECK_INTERVAL = 10
# JOB_RECORD_NODE_USAGES_INTERVAL = 30
# JOB_RECORD_USER_USAGES_INTERVAL = 10
# JOB_REVIEW_USERS_INTERVAL = 10
# JOB_SEND_NOTIFICATIONS_INTERVAL = 30

# ─────────────────────────── Misc ─────────────────────────────────────────
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 1440
## Custom texts for subscription client status banners.
# ACTIVE_STATUS_TEXT = "Active"
# EXPIRED_STATUS_TEXT = "Expired"
# LIMITED_STATUS_TEXT = "Limited"
# DISABLED_STATUS_TEXT = "Disabled"
# ONHOLD_STATUS_TEXT = "On-Hold"
## Negative values disable auto-delete.
# USERS_AUTODELETE_DAYS = -1
# USER_AUTODELETE_INCLUDE_LIMITED_ACCOUNTS = false

# ─────────────────────────── Developers ───────────────────────────────────
# DEBUG = false
# DOCS = false
# VITE_BASE_API = "https://panel.example.com/api/"

# ══════════════════════════════════════════════════════════════════════════
#  Reserved settings — NOT wired yet (documented for the roadmap; setting
#  them has no effect in this release):
#    SMTP_HOST / SMTP_PORT / SMTP_USERNAME / SMTP_PASSWORD / SMTP_FROM
#    OAUTH_GOOGLE_CLIENT_ID / OAUTH_GOOGLE_CLIENT_SECRET
#    OAUTH_GITHUB_CLIENT_ID / OAUTH_GITHUB_CLIENT_SECRET
# ══════════════════════════════════════════════════════════════════════════
