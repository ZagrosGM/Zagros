# chmod 0600 .env. Never commit the populated file.
ZAGROS_NODE_IMAGE=ghcr.io/zagrosgm/zagros-node:alpha
ZAGROS_NODE_NAME=node-1
# Public IP or DNS name used by Master; included in the generated certificate SAN.
ZAGROS_NODE_ADDRESS=203.0.113.10
ZAGROS_NODE_HOST=0.0.0.0
ZAGROS_NODE_PORT=62050
ZAGROS_NODE_DATA=/var/lib/zagros-node
ZAGROS_CORE_DATA=/var/lib/zagros/cores
# SHA-256 hex digest only; the one-time plaintext token is kept separately.
ZAGROS_NODE_REGISTRATION_HASH=
